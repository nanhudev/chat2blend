{
  "manifest_version": 3,
  "name": "Chat2Blend",
  "version": "0.1.0",
  "description": "Capture Blender Python streamed by ChatGPT and execute it in your open Blender instance.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chat2Blend",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://127.0.0.1:8787/fixture/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
